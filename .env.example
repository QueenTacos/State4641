# This app is a static, no-build-step site (plain HTML/CSS/JS) — it does
# NOT read process.env or any Vercel environment variables at runtime.
# This file exists purely as documentation of what the two Supabase values
# correspond to; see SUPABASE_SETUP.md section 5 for the full explanation
# and exactly where these actually go (SUPABASE_CONFIG in data.js).
#
# Do NOT fill these in here and expect them to do anything — copy the real
# values from your NEW State 4641 Supabase project's Project Settings -> API
# page directly into data.js's SUPABASE_CONFIG object instead.

SUPABASE_URL=
SUPABASE_ANON_KEY=
